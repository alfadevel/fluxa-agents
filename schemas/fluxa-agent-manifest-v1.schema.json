{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfluxa.it/schemas/fluxa-agent-manifest-v1.schema.json",
  "title": "Fluxa Agent Pack Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "agentId",
    "version",
    "apiVersion",
    "kind",
    "title",
    "description",
    "minCoreVersion",
    "files",
    "signature"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "type": "string" },
    "kind": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "orgId": { "type": "string" }
      }
    },
    "license": { "type": "string" },
    "visibility": { "enum": ["public", "org", "private"] },
    "minCoreVersion": { "type": "string", "minLength": 1 },
    "requirements": { "type": "object" },
    "skillRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signature": { "type": "string", "minLength": 1 }
  }
}
